.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
artifacts/benchmark/
artifacts/outbox/
artifacts/reconcile/
artifacts/*.pid

# Runtime logs and pid files are never tracked (Phase 6). Authoritative logs
# are preserved inside the immutable run directories under artifacts/runs/ on
# disk; only their sha256 entries (and non-log evidence) are committed.
artifacts/**/*.log
artifacts/**/*.pid

# Working scratch evidence dirs (regenerated every run). Authoritative machine
# evidence is copied into artifacts/runs/<UTC_TIMESTAMP>-<GIT_SHA>/ per run.
# Run directories are preserved on disk but never committed; REPORT.md (derived
# from the newest run) is the committed summary.
artifacts/runs/
artifacts/operaton/
artifacts/flowable/
artifacts/environment.txt
artifacts/pre-operaton-start.txt
artifacts/post-operaton-start.txt
artifacts/resource-preflight.txt
