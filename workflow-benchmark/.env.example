# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg2://benchmark:benchmark@localhost:5432/benchmark
ENGINE_OPERATON_URL=http://localhost:8080/engine-rest
ENGINE_FLOWABLE_URL=http://localhost:8081/flowable-rest/service
DISPATCH_INTERVAL_SECONDS=2.0
RECONCILE_INTERVAL_SECONDS=2.0
OUTBOX_DISPATCHER_ENABLED=true
RECONCILER_ENABLED=true
DEFAULT_WORKFLOW_ENGINE=OPERATON
